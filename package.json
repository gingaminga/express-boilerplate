{
  "name": "base-server-boilerplate",
  "version": "0.0.5",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "cross-env NODE_ENV=production tsc -p . && tsc-alias",
    "dev": "cross-env NODE_ENV=development nodemon --config nodemon.json",
    "eslint": "eslint ./src/**/*.ts",
    "prettier": "prettier --write ./src/**/*.ts",
    "test": "cross-env NODE_ENV=test jest",
    "test:clean": "cross-env NODE_ENV=test jest --clearCache",
    "test:dev": "cross-env NODE_ENV=test jest --watch",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.14.202",
    "@types/on-finished": "^2.3.4",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^16.2.7",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.8",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "ansi-colors": "^4.1.3",
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "express-asyncify": "^2.1.2",
    "inversify": "^7.10.8",
    "joi": "^18.0.2",
    "lodash": "^4.17.21",
    "on-finished": "^2.4.1",
    "reflect-metadata": "^0.2.1",
    "supertest": "^7.1.4",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs}": [
      "eslint --fix --cache",
      "prettier --write --cache"
